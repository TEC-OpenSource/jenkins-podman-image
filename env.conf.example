# podman-compose 1.5.0; no passwords/tokens here.
JENKINS_IMAGE=localhost/jenkins-25:2.580.2-3-amd64
# These defaults are beside podman-compose.yml. Keep these paths on redeployment.
JENKINS_HOME_DIR=./jenkins_home
JENKINS_PLUGINS_DIR=./plugins
JENKINS_HTTP_BIND=0.0.0.0
JENKINS_HTTP_PORT=8080
# Optional HTTPS override (host 8443 by default; use 443 if the host permits it).
JENKINS_SSL_DIR=./ssl
JENKINS_HTTPS_BIND=0.0.0.0
JENKINS_HTTPS_PORT=8443
JAVA_OPTS=-Xms1g -Xmx4g -Djava.awt.headless=true -Duser.timezone=Asia/Seoul
