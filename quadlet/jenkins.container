[Unit]
Description=Imported Jenkins image on JDK 25 (optional alternative to Compose)
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
Image=localhost/jenkins-25:2.580.2-3-amd64
Pull=never
ContainerName=jenkins-25
User=jenkins:jenkins
UserNS=keep-id:uid=1000,gid=1000
# Replace both paths with absolute paths beside podman-compose.yml before installation.
Volume=/REPLACE/jenkins-podman-image/jenkins_home:/var/jenkins_home:Z
Volume=/REPLACE/jenkins-podman-image/plugins:/var/jenkins_home/plugins:Z
PublishPort=0.0.0.0:8080:8080
EnvironmentFile=%h/.config/jenkins/jenkins.env
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target
