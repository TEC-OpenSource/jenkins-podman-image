[Unit]
Description=Imported Jenkins image on JDK 25 (optional alternative to Compose)
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
Image=localhost/jenkins-25:2.580.2-4-amd64
Pull=never
ContainerName=jenkins-25
User=jenkins:jenkins
UserNS=keep-id:uid=1000,gid=1000
# Replace /REPLACE paths with the deployment directory before installation.
Volume=/REPLACE/jenkins-podman-image/jenkins_home:/var/jenkins_home:Z
Volume=/REPLACE/jenkins-podman-image/plugins:/var/jenkins_home/plugins:Z
Volume=/REPLACE/jenkins-podman-image/scripts/healthcheck.sh:/usr/local/bin/jenkins-healthcheck.sh:ro,Z
PublishPort=0.0.0.0:8080:8080
EnvironmentFile=/REPLACE/jenkins-podman-image/env.conf
HealthCmd=/bin/sh /usr/local/bin/jenkins-healthcheck.sh
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=5m
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target
